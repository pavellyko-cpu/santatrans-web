{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "package.json",
      "package-lock.json",
      "test/**",
      ".github",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "**/*.js", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]}
    ]
  },
  "emulators": {
    "auth": {"port": 9099},
    "database": {"port": 9000},
    "hosting": {"port": 5000},
    "ui": {"enabled": true},
    "singleProjectMode": true
  }
}
